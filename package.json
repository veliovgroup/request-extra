{
  "name": "request-libcurl",
  "version": "4.1.0",
  "description": "Extremely stable HTTP request module built on top of libcurl",
  "main": "index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "docs/platform-notes.md"
  ],
  "scripts": {
    "build": "rollup --config rollup.config.js",
    "prepack": "npm run build",
    "test": "npm run test:node && npm run test:types",
    "test:node": "mocha ./test/npm.js",
    "test:types": "tsc -p test/tsconfig.node.json --noEmit && tsc -p test/tsconfig.bun.json --noEmit",
    "test:bun": "bun test ./test/bun.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veliovgroup/request-extra.git"
  },
  "keywords": [
    "request",
    "libcurl",
    "curl",
    "repeats",
    "http",
    "http2",
    "http3",
    "https",
    "post",
    "get",
    "async",
    "fetch",
    "API",
    "rest",
    "request-libcurl",
    "request-extra"
  ],
  "tags": [
    "request",
    "libcurl",
    "curl",
    "repeats",
    "http",
    "http2",
    "http3",
    "https",
    "post",
    "get",
    "async",
    "fetch",
    "API",
    "rest",
    "request-libcurl",
    "request-extra"
  ],
  "author": "dr.dimitru (https://veliovgroup.com)",
  "engines": {
    "node": ">=22.14"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/veliovgroup/request-extra/issues"
  },
  "homepage": "https://github.com/veliovgroup/request-extra#readme",
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^12.0.0",
    "rollup": "^4.63.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "node-libcurl": "^5.1.2"
  },
  "overrides": {
    "brace-expansion@2": "2.1.4"
  }
}
